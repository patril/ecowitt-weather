elds":"","values":false},"textMode":"auto","wideLayout":true},"targets":[{"editorMode":"code","format":"table","rawQuery":true,"rawSql":"SELECT weekly_rain_in AS \"This week\" FROM rain_observation WHERE source = 'wh40' ORDER BY observed_at DESC LIMIT 1","refId":"A"}],"title":"Rainfall This Week","type":"stat"},{"datasource":{"type":"postgres","uid":"weather-postgres"},"fieldConfig":{"defaults":{"unit":"suffix: in","decimals":2},"overrides":[]},"gridPos":{"h":4,"w":4,"x":12,"y":6},"id":16,"options":{"colorMode":"value","graphMode":"none","justifyMode":"auto","orientation":"auto","reduceOptions":{"calcs":["lastNotNull"],"fields":"","values":false},"textMode":"auto","wideLayout":true},"targets":[{"editorMode":"code","format":"table","rawQuery":true,"rawSql":"SELECT monthly_rain_in AS \"This month\" FROM rain_observation WHERE source = 'wh40' ORDER BY observed_at DESC LIMIT 1","refId":"A"}],"title":"Rainfall This Month","type":"stat"},{"datasource":{"type":"postgres","uid":"weather-postgres"},"fieldConfig":{"defaults":{"unit":"suffix: in","decimals":2},"overrides":[]},"gridPos":{"h":4,"w":4,"x":16,"y":6},"id":17,"options":{"colorMode":"value","graphMode":"none","justifyMode":"auto","orientation":"auto","reduceOptions":{"calcs":["lastNotNull"],"fields":"","values":false},"textMode":"auto","wideLayout":true},"targets":[{"editorMode":"code","format":"table","rawQuery":true,"rawSql":"SELECT yearly_rain_in AS \"This year\" FROM rain_observation WHERE source = 'wh40' ORDER BY observed_at DESC LIMIT 1","refId":"A"}],"title":"Rainfall This Year","type":"stat"},{"datasource":{"type":"postgres","uid":"weather-postgres"},"fieldConfig":{"defaults":{},"overrides":[]},"gridPos":{"h":4,"w":4,"x":20,"y":6},"id":21,"options":{"colorMode":"value","graphMode":"none","justifyMode":"auto","orientation":"auto","reduceOptions":{"calcs":["lastNotNull"],"fields":"","values":false},"textMode":"auto","wideLayout":true},"targets":[{"editorMode":"code","format":"table","rawQuery":true,"rawSql":"WITH RECURSIVE\nparams AS (\n  SELECT CURRENT_DATE AS today\n),\ntoday_rain AS (\n  SELECT COALESCE(MAX(r.daily_rain_in), 0) > 0 AS wet\n  FROM rain_observation r\n  CROSS JOIN params p\n  WHERE r.source = 'wh40'\n    AND r.observed_at >= p.today::timestamptz\n    AND r.observed_at < (p.today + 1)::timestamptz\n),\ndays AS (\n  SELECT s.observation_date, COALESCE(s.rainfall_in, 0) > 0 AS wet\n  FROM daily_weather_summary s\n  CROSS JOIN params p\n  WHERE s.observation_date < p.today\n\n  UNION ALL\n\n  SELECT p.today, TRUE\n  FROM params p\n  CROSS JOIN today_rain t\n  WHERE t.wet\n),\nanchor AS (\n  SELECT d.observation_date, d.wet\n  FROM days d\n  CROSS JOIN params p\n  CROSS JOIN today_rain t\n  WHERE d.observation_date = CASE WHEN t.wet THEN p.today ELSE p.today - 1 END\n),\nstreak AS (\n  SELECT a.observation_date, a.wet, 1 AS days\n  FROM anchor a\n\n  UNION ALL\n\n  SELECT d.observation_date, d.wet, s.days + 1\n  FROM streak s\n  JOIN days d\n    ON d.observation_date = s.observation_date - 1\n   AND d.wet = s.wet\n)\nSELECT\n  (CASE WHEN a.wet THEN 'Rain streak: ' ELSE 'Dry streak: ' END)\n  || MAX(s.days)\n  || CASE WHEN MAX(s.days) = 1 THEN ' day' ELSE ' days' END AS \"Current streak\"\nFROM streak s\nCROSS JOIN anchor a\nGROUP BY a.wet","refId":"A"}],"title":"Current Rain / Dry Streak","type":"stat"},{"datasource":{"type":"postgres","uid":"weather-postgres"},"fieldConfig":{"defaults":{"unit":"suffix: °F","decimals":1},"overrides":[]},"gridPos":{"h":8,"w":24,"x":0,"y":10},"id":9,"options":{"legend":{"calcs":[],"displayMode":"list","placement":"bottom","showLegend":true},"tooltip":{"mode":"multi","sort":"none"}},"targets":[{"editorMode":"code","format":"time_series","rawQuery":true,"rawSql":"SELECT observed_at AS \"time\", outdoor_temp_f AS \"Outdoor temperature\", feels_like_f AS \"Feels like\", dewpoint_f AS \"Dew point\" FROM weather_observation WHERE $__timeFilter(observed_at) ORDER BY observed_at","refId":"A"}],"title":"Temperature","type":"timeseries"}