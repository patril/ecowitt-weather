          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT observation_date::timestamp + INTERVAL '12 hours' AS \"time\", high_temp_f AS \"High temperature\", low_temp_f AS \"Low temperature\", mean_dewpoint_f AS \"Mean dew point\" FROM daily_weather_summary WHERE $__timeFilter(observation_date::timestamp + INTERVAL '12 hours') ORDER BY observation_date",
          "refId": "A"
        }
      ],
      "title": "Daily Temperature / Dew Point",
      "type": "timeseries"
    },
    {
      "id": 8,
      "title": "Time of Daily High / Low Temperature",
      "description": "Local time of day when each day's highest and lowest outdoor temperatures first occurred. Y-axis is decimal hours on a 24-hour clock (e.g., 14.5 = 2:30 PM). Times are America/New_York.",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "weather-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "min": 0,
          "max": 24,
          "custom": {
            "axisLabel": "Local time of day (24-hour clock)",
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "showPoints": "always",
            "pointSize": 5,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  observation_date::timestamp + INTERVAL '12 hours' AS \"time\",\n  EXTRACT(EPOCH FROM (high_temp_at AT TIME ZONE 'America/New_York')::time) / 3600.0 AS \"Time of high\",\n  EXTRACT(EPOCH FROM (low_temp_at AT TIME ZONE 'America/New_York')::time) / 3600.0 AS \"Time of low\"\nFROM daily_weather_summary\nWHERE $__timeFilter(observation_date::timestamp + INTERVAL '12 hours')\nORDER BY observation_date",
          "refId": "A"
        }
      ]
    },
