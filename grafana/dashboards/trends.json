        {
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH buckets AS (SELECT floor(extract(epoch FROM observed_at) / 300) AS bucket, AVG(solar_w_m2) AS irradiance, AVG(outdoor_temp_f) AS temperature FROM weather_observation WHERE $__timeFilter(observed_at) AND solar_w_m2 > 10 AND outdoor_temp_f IS NOT NULL GROUP BY 1) SELECT irradiance AS \"Irradiance\", temperature AS \"Temperature\" FROM buckets ORDER BY bucket",
