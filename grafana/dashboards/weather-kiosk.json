      "id": 3,
      "options": {
        "add100Percentage": true,
        "centerAlignContent": true,
        "overflow": "hidden",
        "useGrafanaScrollbar": false,
        "SVGBaseFix": true,
        "codeData": "{}",
        "rootCSS": "",
        "css": ".wind-card { height: 100%; display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 7px; box-sizing: border-box; padding: 4px; color: var(--grafana-text-primary, #e8edf4); font-family: Inter, Arial, sans-serif; text-align: center; } .wind-main { font-size: clamp(20px, 2.5vw, 34px); font-weight: 650; line-height: 1.1; white-space: nowrap; } .wind-gust { font-size: clamp(15px, 1.65vw, 22px); opacity: .82; white-space: nowrap; }",
        "html": "<div class=\"wind-card\"><div class=\"wind-main\" id=\"wind-main\">-- mph --</div><div class=\"wind-gust\" id=\"wind-gust\">Gust -- mph</div></div>",
        "onRender": "const fields = data.series?.flatMap(series => series.fields || []) || [];\nconst last = name => {\n  const field = fields.find(f => f.name === name);\n  if (!field?.values?.length) return null;\n  const i = field.values.length - 1;\n  const value = field.values.get ? field.values.get(i) : field.values[i];\n  return value == null || !Number.isFinite(Number(value)) ? null : Number(value);\n};\nconst speed = last('Wind speed');\nconst direction = last('Wind direction');\nconst gust = last('Wind gust');\nconst main = htmlNode.getElementById('wind-main');\nconst gustNode = htmlNode.getElementById('wind-gust');\nif (!main || !gustNode) return;\nconst compass = ['N','NNE','NE','ENE','E','ESE','SE','SSE','S','SSW','SW','WSW','W','WNW','NW','NNW'];\nconst bearing = direction === null ? '--' : compass[Math.round((((direction % 360) + 360) % 360) / 22.5) % 16];\nmain.textContent = speed === null ? 'Wind unavailable' : speed.toFixed(1) + ' mph ' + bearing;\ngustNode.textContent = gust === null ? 'Gust unavailable' : 'Gust ' + gust.toFixed(1) + ' mph';",
        "renderOnMount": true,
        "panelupdateOnMount": true,
        "dynamicHtmlGraphics": false,
        "dynamicData": false,
        "dynamicFieldDisplayValues": false,
        "dynamicProps": false,
        "onInitOnResize": false,
        "onInit": ""
      },
